# OS junk
.DS_Store

# Python cache
__pycache__/
*.pyc

# CSVs (embeddings, etc.)
*.csv

# Editor

# Dataset contents (folders kept, files ignored)
Dataset/real/*
Dataset/fake/*
!Dataset/real/.gitkeep
!Dataset/fake/.gitkeep

# Model checkpoints
outputs/checkpoints/

# Outputs (generated at runtime, folder kept via .gitkeep)
outputs/*
!outputs/.gitkeep
.vscode/
